{
  "name": "gremlin-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:ext": "turbo dev --filter=@gremlin/extension",
    "dev:api": "turbo dev --filter=@gremlin/backend",
    "dev:web": "turbo dev --filter=@gremlin/web",
    "build": "turbo build",
    "build:web": "turbo build --filter=@gremlin/web",
    "compile": "turbo compile",
    "deploy:api": "pnpm --filter @gremlin/backend run deploy"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "packageManager": "pnpm@10.14.0"
}
