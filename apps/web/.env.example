# ==============================================================================
# Gremlin Web Application Environment Configuration
# ==============================================================================

# Backend API URL (Cloudflare Worker or local dev: http://localhost:8787)
VITE_API_URL="http://localhost:8787"

# Paddle Billing Configuration (sandbox-vendors.paddle.com or vendors.paddle.com)
# Client-side token (Developer tools > Authentication > Client-side tokens)
VITE_PADDLE_CLIENT_TOKEN="live_..."

# Price ID for Gremlin Pro Monthly (/mo)
VITE_PADDLE_PRO_PRICE_ID="pri_..."

# Paddle Environment: sandbox | production
VITE_PADDLE_ENV="sandbox"
