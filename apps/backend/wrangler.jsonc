{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gremlin-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "dev": {
    "port": 8700
  },
  "vars": {
    "BETTER_AUTH_URL": "https://gremlin-backend.rchdmaranga-b12.workers.dev",
    "FRONTEND_URL": "https://gremlin.fasihi.xyz",
    "NODE_ENV": "production",
    "POLAR_ENV": "production",
    "ALLOWED_ORIGINS": "https://gremlin.fasihi.xyz,http://localhost:5173"
  }
}