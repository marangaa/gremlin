# ==============================================================================
# Gremlin Backend (Hono + Better Auth + Neon Serverless) Environment Configuration
# ==============================================================================

# 1. Neon PostgreSQL Pooled Connection String (from console.neon.tech)
DATABASE_URL="postgres://username:password@ep-your-pooler-subdomain.region.aws.neon.tech/neondb?sslmode=require"

# 2. Better Auth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-32-byte-secret-key-here"

# 3. Canonical Worker API URL (your Cloudflare workers.dev or custom domain)
BETTER_AUTH_URL="https://<your-worker-name>.<your-subdomain>.workers.dev"

# 4. Server-Side AI Agent Provider Keys (Provide at least one for Cloud Mode)
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"
# OPENAI_API_KEY="your-openai-api-key"
# GROQ_API_KEY="your-groq-api-key"
# ANTHROPIC_API_KEY="your-anthropic-api-key"

# 5. Origin Allowlist (CORS + Better Auth trustedOrigins)
# Comma-separated Chrome extension IDs (from chrome://extensions or your CWS draft).
# Required for production; when unset outside production any extension origin is
# tolerated for local development.
ALLOWED_EXTENSION_IDS=""
# Extra exact web origins, comma-separated (e.g. "https://gremlin.fasihi.xyz")
ALLOWED_ORIGINS=""
# Set to "production" to disable permissive dev fallbacks (localhost + wildcard extensions)
NODE_ENV="development"

# 6. Paddle Billing (from sandbox-vendors.paddle.com or vendors.paddle.com)
# Server-side API key (under Developer tools > Authentication > API keys)
PADDLE_API_KEY="pdl_sdbx_apikey_..."
# Webhook notification secret (under Developer tools > Notifications > your destination)
PADDLE_NOTIFICATION_WEBHOOK_SECRET="pdl_ntfset_..."
# Paddle Catalog Price IDs
PADDLE_PRO_PRICE_ID="pri_..."
PADDLE_FOUNDER_PRICE_ID="pri_..."
# Paddle Environment: sandbox | production
PADDLE_ENV="sandbox"
