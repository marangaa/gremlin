# ==============================================================================
# Gremlin Backend (Hono + Better Auth + Polar.sh + Neon) Environment Configuration
# ==============================================================================

# 1. Neon PostgreSQL Pooled Connection String (from console.neon.tech)
DATABASE_URL="postgres://username:password@ep-your-pooler-subdomain.region.aws.neon.tech/neondb?sslmode=require"

# 2. Better Auth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-32-byte-secret-key-here"

# 3. Canonical Worker API URL (your Cloudflare workers.dev or custom domain)
BETTER_AUTH_URL="https://<your-worker-name>.<your-subdomain>.workers.dev"

# 4. Server-Side AI Agent Provider Keys (provide at least one for Cloud Mode)
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"
# OPENAI_API_KEY="sk-..."
# GROQ_API_KEY="gsk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# 4b. Public frontend URL used for Polar checkout successUrl redirects.
# Local dev default: http://localhost:5173
FRONTEND_URL="http://localhost:5173"

# 5. Origin Allowlist (CORS + Better Auth trustedOrigins)
# Comma-separated Chrome extension IDs (from chrome://extensions or your CWS draft).
# Required for production; when unset outside production localhost dev origins apply.
ALLOWED_EXTENSION_IDS=""
# Extra exact web origins, comma-separated (e.g. "https://gremlin.fasihi.xyz")
ALLOWED_ORIGINS=""
# Set to "production" to lock down permissive dev fallbacks
NODE_ENV="development"

# 6. Polar.sh Billing (dashboard.polar.sh / sandbox.polar.sh > Organization Settings)
# Organization Access Token. Sandbox and production tokens are NOT interchangeable.
POLAR_ACCESS_TOKEN="polar_oat_..."
# Webhook signing secret (whsec_...) for Standard Webhooks HMAC verification.
POLAR_WEBHOOK_SECRET="whsec_..."
# Polar Product ID for the Gremlin Pro subscription ($5/mo).
POLAR_PRO_PRODUCT_ID="..."
# Polar environment: sandbox | production
POLAR_ENV="sandbox"
